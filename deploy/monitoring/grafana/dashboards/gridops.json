{
 "title": "GridOps model server",
 "uid": "gridops",
 "schemaVersion": 39,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Champion model version",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "gridops_model_version",
     "legendFormat": "version",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Holdout MAE (gCO2/kWh)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "gridops_model_holdout_mae",
     "legendFormat": "MAE",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Requests per second",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(gridops_http_requests_total[1m])) by (path)",
     "legendFormat": "{{path}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "p95 latency by endpoint",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(gridops_http_request_seconds_bucket[5m])) by (le, path))",
     "legendFormat": "{{path}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Error rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(gridops_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(gridops_http_requests_total[5m]))",
     "legendFormat": "errors",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "heatmap",
   "title": "Predicted carbon intensity (distribution)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(gridops_prediction_gco2_per_kwh_bucket[5m])) by (le)",
     "legendFormat": "{{le}}",
     "refId": "A"
    }
   ]
  }
 ]
}